# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string.
DATABASE_URL="postgresql://turnkeep:turnkeep@localhost:5432/turnkeep?schema=public"

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Used in calendar event descriptions so staff can jump back into the app.
APP_URL="http://localhost:3000"

# Fallback timezone for properties that don't carry one.
DEFAULT_TIMEZONE="America/New_York"


# ─── Hostaway (one-way pull: reservations in, nothing written back) ──────────
# Account ID is the "client id"; the API key is the "client secret".
# Hostaway dashboard → Settings → Hostaway API.
HOSTAWAY_ACCOUNT_ID=""
HOSTAWAY_API_KEY=""
HOSTAWAY_BASE_URL="https://api.hostaway.com/v1"


# ─── Google Calendar ─────────────────────────────────────────────────────────
# A service account key from Google Cloud. Keep the \n escapes in the private key.
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# The calendar events land on. "primary" means the impersonated user's own calendar.
GOOGLE_CALENDAR_ID="primary"

# REQUIRED FOR INVITES. A Workspace user the service account may impersonate via
# domain-wide delegation. Without it events are still created, but attendees
# never receive an invitation.
GOOGLE_IMPERSONATE_USER=""


# ─── AI scheduling (optional) ────────────────────────────────────────────────
# Without a key the scheduler still runs on its built-in rule scoring.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"


# ─── Photo storage ───────────────────────────────────────────────────────────
# "local" writes to disk — fine for a single box, but on most container hosts
# the filesystem is wiped on redeploy, so point STORAGE_LOCAL_DIR at a mounted
# volume or use "s3".
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"

# Cap on one upload. Photos are downscaled in the browser before sending, so
# this is a backstop rather than the normal size.
MAX_UPLOAD_BYTES="15728640"

# Any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO, Backblaze B2.
# Keep the bucket PRIVATE — reads are served through short-lived signed URLs.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Required for R2, MinIO and other non-AWS gateways; leave blank for AWS.
S3_ENDPOINT=""
# MinIO and most self-hosted gateways need this set to true.
S3_FORCE_PATH_STYLE="false"
S3_SIGNED_URL_SECONDS="3600"


# ─── Background jobs ─────────────────────────────────────────────────────────
# Lets an external scheduler call POST /api/cron without a login:
#   Authorization: Bearer <CRON_SECRET>   or   /api/cron?key=<CRON_SECRET>
CRON_SECRET=""
